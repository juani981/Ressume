# Ressume — copy to .env for local dev. Never commit .env.
# Feature flags (all optional, defaults shown)
VITE_ENABLE_TWO_COLUMN_MODE=false
VITE_ENABLE_BITACORA=false
VITE_ENABLE_BITACORA_TOUR=false

# Supabase-backed Bitácora (optional — without these, Bitácora falls back to local data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
